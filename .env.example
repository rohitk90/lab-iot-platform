# ==============================================================================
# LAB IIOT PLATFORM - CONFIGURATION PROFILE (PHASE 1A)
# ==============================================================================

# Physical directory on your Linux host where all data will be permanently saved.
# In a standard Linux server deployment, /var/lib/ is the standard path.
DATA_PATH=/var/lib/lab-platform/data

# ------------------------------------------------------------------------------
# TIMESCALEDB / POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_DB=lab_platform
POSTGRES_USER=lab_admin
POSTGRES_PASSWORD=ReplaceWithAStrongSecurePassword2026

# ------------------------------------------------------------------------------
# MINIO OBJECT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# These will be the root login credentials for the MinIO Web Console (Port 9001)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=ReplaceWithAMinioSecurePassword2026
