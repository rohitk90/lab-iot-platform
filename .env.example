# ==============================================================================
# LAB IIOT PLATFORM - CONFIGURATION PROFILE (V2)
#
# INSTRUCTIONS:
#   1. Copy this file to .env:    cp .env.example .env
#   2. Change ALL passwords marked "ReplaceWith..." to strong, unique values.
#   3. Run:                       docker compose up -d
#
# WARNING: The docker-compose.yml file is configured to REFUSE to start if
# REDIS_PASSWORD or GRAFANA_ADMIN_PASSWORD are left blank.
# ==============================================================================

# ------------------------------------------------------------------------------
# SYSTEM PATHS & PORTS
# ------------------------------------------------------------------------------
# Physical directory on your Linux host where all persistent data is stored.
DATA_PATH=/var/lib/lab-platform/data

# Bind internal services (Postgres, Redis, MinIO, Grafana, EMQX Dashboard) to 
# localhost only. Change to 0.0.0.0 ONLY if you need direct LAN access to them.
INTERNAL_BIND=127.0.0.1


# ------------------------------------------------------------------------------
# TIMESCALEDB / POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_DB=lab_platform
POSTGRES_USER=lab_admin
POSTGRES_PASSWORD=ReplaceWithAStrongSecurePassword2026

# Postgres Memory Tuning (Optimized for the 8GB RAM Dell OptiPlex)
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_MAINTENANCE_WORK_MEM=512MB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=50
PG_MAX_WAL_SIZE=4GB


# ------------------------------------------------------------------------------
# MQTT BROKER (EMQX) & TELEGRAF CONFIGURATION
# ------------------------------------------------------------------------------
# These are the credentials Edge Telegraf uses to publish to EMQX.
# The Central Telegraf uses these same credentials to subscribe.
TELEGRAF_MQTT_USER=telegraf
TELEGRAF_MQTT_PASSWORD=ReplaceWithAnMqttSecurePassword2026


# ------------------------------------------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------------------------------------------
# Required. The compose file will fail if this is empty.
REDIS_PASSWORD=ReplaceWithARedisSecurePassword2026


# ------------------------------------------------------------------------------
# GRAFANA CONFIGURATION
# ------------------------------------------------------------------------------
# Required. This is the login for the Grafana admin UI.
GRAFANA_ADMIN_PASSWORD=ReplaceWithAGrafanaSecurePassword2026


# ------------------------------------------------------------------------------
# MINIO OBJECT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Root login credentials for the MinIO Web Console (Port 9001) and S3 API.
# Used by the archival worker to export old telemetry chunks.
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=ReplaceWithAMinioSecurePassword2026


# ------------------------------------------------------------------------------
# IMAGE TAGS (Pinned for reproducibility)
# ------------------------------------------------------------------------------
# Leave these as-is unless you have a specific reason to upgrade.
TIMESCALEDB_IMAGE=timescale/timescaledb:latest-pg16
EMQX_IMAGE=emqx/emqx:5.8.0
REDIS_IMAGE=redis:7.2-alpine
MINIO_IMAGE=pgsty/minio
GRAFANA_IMAGE=grafana/grafana-oss:latest
NGINX_IMAGE=nginx:alpine
TELEGRAF_IMAGE=telegraf:alpine
